# ============================================================
# ProjectMind AI — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
# .env is in .gitignore — it will NEVER be committed to git.
# Only .env.example is committed (it has no real secrets).
# ============================================================

# -------------------------------------------------------
# Which LLM provider to use
# Options: nemotron, groq, gemini (more providers added later)
# -------------------------------------------------------
LLM_PROVIDER=groq

# -------------------------------------------------------
# Groq (cloud API) settings
# Get your key at: https://console.groq.com/keys
# -------------------------------------------------------
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# -------------------------------------------------------
# Gemini (Google AI Studio) settings
# Get your key at: https://aistudio.google.com/
# -------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# -------------------------------------------------------
# Nemotron — local llama-server settings (optional)
# Only needed if LLM_PROVIDER=nemotron
#
# Start llama-server first:
#   llama-server -m "C:\path\to\your-model.gguf" --port 8080
# -------------------------------------------------------
NEMOTRON_BASE_URL=http://localhost:8080
NEMOTRON_MODEL=nemotron
