# ============================================================
# ProjectMind AI — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
# .env is in .gitignore — it will NEVER be committed to git.
# Only .env.example is committed (it has no real secrets).
# ============================================================

# -------------------------------------------------------
# Which LLM provider to use
# Options: nemotron, groq, gemini (more providers added later)
# -------------------------------------------------------
LLM_PROVIDER=groq

# -------------------------------------------------------
# Groq (cloud API) settings
# Get your key at: https://console.groq.com/keys
# -------------------------------------------------------
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# -------------------------------------------------------
# Gemini (Google AI Studio) settings
# Get your key at: https://aistudio.google.com/
# -------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# -------------------------------------------------------
# Nemotron — local llama-server settings (optional)
# Only needed if LLM_PROVIDER=nemotron
#
# Start llama-server first:
#   llama-server -m "C:\path\to\your-model.gguf" --port 8080
# -------------------------------------------------------
NEMOTRON_BASE_URL=http://localhost:8080
NEMOTRON_MODEL=nemotron

# -------------------------------------------------------
# Phase 22: Task-to-Model Specialization Tiers (Optional Overrides)
# FAST: For intent routing, classification, tool dispatching (<300ms)
# BALANCED: For review, testing, documentation, standard chats
# COMPLEX: For coding, deep refactoring, architectural synthesis
# LOCAL: For privacy-first / offline local development
# -------------------------------------------------------
TIER_FAST_PROVIDER=groq
TIER_FAST_MODEL=llama-3.3-70b-versatile
TIER_BALANCED_PROVIDER=gemini
TIER_BALANCED_MODEL=gemini-2.5-flash
TIER_COMPLEX_PROVIDER=gemini
TIER_COMPLEX_MODEL=gemini-2.5-pro
TIER_LOCAL_PROVIDER=nemotron
TIER_LOCAL_MODEL=nemotron

# -------------------------------------------------------
# Phase 23: MongoDB Atlas Persistence Settings
# Get your connection string from MongoDB Atlas Dashboard -> Connect -> Drivers
# -------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=projectmind


