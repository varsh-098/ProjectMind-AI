# ============================================================
# ProjectMind AI — Production Environment Template
# ============================================================

# --- Core Server Settings ---
PORT=8000
ENV=production
DEBUG=false

# --- CORS & Security Policy ---
# Comma-separated list of permitted origins (no trailing slashes, exact match)
CORS_ALLOWED_ORIGINS=https://app.projectmind.ai,https://api.projectmind.ai

# --- Session Cookie Configuration ---
# In HTTPS production, set COOKIE_SECURE=true
COOKIE_SECURE=true
# Use 'lax' for same-site or 'none' if API and frontend are on distinct domains with HTTPS
COOKIE_SAMESITE=lax
COOKIE_NAME=projectmind_session
COOKIE_MAX_AGE=604800

# --- MongoDB Database Persistence ---
# Use your production MongoDB Atlas cluster URI or internal MongoDB replica set
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=projectmind
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50

# --- LLM Providers & API Keys ---
# Configure one or more LLM providers for the multi-model tier fallback
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIzaSy...
NEMOTRON_API_KEY=nvapi-...
PRIMARY_MODEL_TIER=nemotron
FALLBACK_ENABLED=true

